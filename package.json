{
  "name": "shellpilot",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "powershell -ExecutionPolicy Bypass -File scripts/tauri-with-rust-path.ps1",
    "tauri:dev": "powershell -ExecutionPolicy Bypass -File scripts/tauri-with-rust-path.ps1 dev",
    "tauri:build": "powershell -ExecutionPolicy Bypass -File scripts/tauri-with-rust-path.ps1 build",
    "release:win": "powershell -ExecutionPolicy Bypass -File scripts/release-win.ps1",
    "release:win:build": "powershell -ExecutionPolicy Bypass -File scripts/tauri-with-rust-path.ps1 build --bundles nsis",
    "release:win:portable": "powershell -ExecutionPolicy Bypass -File scripts/tauri-with-rust-path.ps1 build --no-bundle",
    "release:win:installer": "powershell -ExecutionPolicy Bypass -File scripts/tauri-with-rust-path.ps1 build --bundles nsis"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-context-menu": "^2.3.2",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flexlayout-react": "^0.9.2",
    "lucide-react": "^1.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.81.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
